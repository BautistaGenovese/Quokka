PORT=4000
DATABASE_URL=postgresql://root:rootpassword@localhost:5433/portfolio_integrador

# URL del Frontend (CORS) - En producción colocar la URL de Vercel (ej: https://quokka.vercel.app)
FRONTEND_URL=http://localhost:3000

# Configuración de Correo (Nodemailer)
# Si se dejan vacíos o con el valor de ejemplo, el backend usa automáticamente una cuenta de prueba Ethereal
# ATENCIÓN: En Gmail, usar "Contraseña de Aplicación" de 16 caracteres, nunca la contraseña personal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_de_16_letras
CONTACT_RECEIVER_EMAIL=tu_correo@gmail.com

# Configuración de Autenticación (JWT y Google OAuth)
# En producción generar un hash aleatorio de al menos 32 caracteres (ej: crypto.randomBytes(32).toString('hex'))
JWT_SECRET=tu_clave_secreta_super_segura_quokka_2026
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com

# Integración con GitHub (perfiles del equipo en GET /api/github/miembros)
# Ambas son OPCIONALES: sin ellas se usa la lista de integrantes por defecto.
# Formato de GITHUB_USUARIOS: "Nombre Apellido:usuario,Otro Nombre:otrousuario"
# GITHUB_USUARIOS=
# Un token personal de GitHub sube el límite de consultas de 60 a 5000 por hora.
# GITHUB_TOKEN=
