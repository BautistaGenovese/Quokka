# Copiar a .env.laptop. Usar contraseñas aleatorias alfanuméricas o hexadecimales.
# La URL de PostgreSQL se construye con esta contraseña; evita caracteres que deban codificarse en una URL.
POSTGRES_PASSWORD=REEMPLAZAR_CON_HEX_ALEATORIO
JWT_SECRET=REEMPLAZAR_CON_OTRO_HEX_ALEATORIO

# Opcional. Google OAuth requiere agregar el origen público a Google Cloud.
GOOGLE_CLIENT_ID=

# Opcional. Sin SMTP real, los correos del formulario van a una cuenta de prueba.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=

# Opcional. Integración de perfiles de GitHub.
GITHUB_USUARIOS=
GITHUB_TOKEN=
